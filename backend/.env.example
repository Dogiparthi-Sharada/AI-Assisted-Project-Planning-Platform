# Copy to `.env` for local development. Never commit real values.

# development | test | staging | production
# In production, DATABASE_URL and SUPABASE_URL are required (startup fails otherwise)
# and the OpenAPI docs are disabled unless ENABLE_DOCS=true.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Port uvicorn binds to. Railway injects this automatically.
PORT=8000

# Supabase Postgres via the Supavisor *session* pooler (IPv4, port 5432):
#   Dashboard -> Connect -> Session pooler.
# The transaction pooler (port 6543) also works: statement caching is disabled.
# A plain postgresql:// URL is fine; the driver is switched to asyncpg automatically.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# TLS mode for the DB connection: disable | allow | prefer | require | verify-ca | verify-full
# (an `sslmode=` query parameter on DATABASE_URL takes precedence). Use `require` for Supabase.
DATABASE_SSL=require

# Optional pool / timeout tuning (defaults shown; sized for a small Railway instance).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_S=10
# DB_POOL_RECYCLE_S=1800
# DB_STATEMENT_TIMEOUT_MS=15000

# Supabase project URL (no trailing slash). Used for the JWKS endpoint
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json) and to validate the token issuer.
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional. Only needed if the project still issues legacy HS256 tokens
# (Dashboard -> Project Settings -> JWT Keys -> Legacy JWT secret).
SUPABASE_JWT_SECRET=

# Optional JWT tuning (defaults shown).
# JWT_LEEWAY_S=10
# JWKS_CACHE_LIFESPAN_S=600

# Comma-separated list of allowed browser origins. `*` is rejected.
CORS_ORIGINS=http://localhost:5173,http://localhost:8443

# Force OpenAPI docs on/off at /api/docs (default: on everywhere except production).
# ENABLE_DOCS=true

# Optimizer. CP-SAT is the default. Select Gurobi only after installing gurobipy
# and configuring a license valid for the target environment and use.
# No automatic fallback: Gurobi errors fail the run without switching solvers.
# OPTIMIZER_SOLVER=cpsat
# OPTIMIZER_SOLVER=gurobi
# To include Gurobi in the API Docker image, set the non-secret build arg
# INSTALL_GUROBI=1; the image defaults to 0. On Railway set INSTALL_GUROBI=1
# as an API service build variable and redeploy the image. A license is also
# needed at runtime; package installation alone is not a license.
# Provide license credentials at runtime using your licensed configuration,
# for example GRB_LICENSE_FILE pointing to a securely mounted license file.
# Never put license content or credentials in build args or version control.
# GRB_LICENSE_FILE=/run/secrets/gurobi.lic
#   OPTIMIZER_TIME_LIMIT_S : limit per solve (0-300). Explaining an infeasible
#                            model may take up to the same time again.
#   OPTIMIZER_WORKERS      : solver threads per run (1-32). Keep below the vCPU count.
#   OPTIMIZER_STALE_AFTER_S: queued/running runs older than this are marked failed (server
#                            restarted mid-run). Must exceed 2 x OPTIMIZER_TIME_LIMIT_S.
# OPTIMIZER_TIME_LIMIT_S=20
# OPTIMIZER_WORKERS=4
# OPTIMIZER_STALE_AFTER_S=180

# Optional AI intake; sends project notes to OpenAI and can incur provider charges.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Set automatically by Railway; reported by GET /health as `version`.
# RAILWAY_GIT_COMMIT_SHA=
